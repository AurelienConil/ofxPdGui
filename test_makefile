# Simple makefile for testing syntax only
CXX = g++
CXXFLAGS = -std=c++17 -Wall -Wextra -I./src
SRCDIR = src
SOURCES = $(wildcard $(SRCDIR)/*.cpp)
OBJECTS = $(SOURCES:.cpp=.o)

# Dummy target to test compilation syntax
syntax-check: $(OBJECTS)
	@echo "Syntax check complete"

%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

clean:
	rm -f $(SRCDIR)/*.o

.PHONY: syntax-check clean